{
  "name": "magic-gostop-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "매직고스톱 온라인 대전 서버 (무작위 대전 + 친구 방 코드 대전). 규칙 엔진은 ../game/src/engine 을 그대로 쓴다",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js"
  },
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": { "esbuild": "^0.25.0", "@types/ws": "^8.5.12" }
}
