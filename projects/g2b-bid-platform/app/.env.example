# 이 파일은 이름만 적은 견본이다. 실제 값은 app\.env 에 적고, .env 는 git에 올리지 않는다.
DATA_GO_KR_KEY_ENCODING=
DATA_GO_KR_KEY_DECODING=
TELEGRAM_BOT_TOKEN=

# 아래는 선택 항목(비워 두면 기본값)
